# Временные файлы Python и Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Виртуальное окружение
venv/
.venv/
env/

# Защита сырых данных и логов от случайностей
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.log
*.jsonl

# Веса и модели
models/*
!models/.gitkeep

# Служебные файлы
.vscode/
.idea/
.DS_Store
